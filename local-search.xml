<span class="line">147</span><br><span class="line">148</span><br><span class="line">149</span><br><span class="line">150</span><br><span class="line">151</span><br><span class="line">152</span><br><span class="line">153</span><br><span class="line">154</span><br><span class="line">155</span><br><span class="line">156</span><br><span class="line">157</span><br><span class="line">158</span><br><span class="line">159</span><br><span class="line">160</span><br><span class="line">161</span><br><span class="line">162</span><br><span class="line">163</span><br><span class="line">164</span><br><span class="line">165</span><br><span class="line">166</span><br><span class="line">167</span><br><span class="line">168</span><br><span class="line">169</span><br><span class="line">170</span><br><span class="line">171</span><br><span class="line">172</span><br><span class="line">173</span><br><span class="line">174</span><br><span class="line">175</span><br><span class="line">176</span><br><span class="line">177</span><br><span class="line">178</span><br><span class="line">179</span><br><span class="line">180</span><br><span class="line">181</span><br><span class="line">182</span><br><span class="line">183</span><br><span class="line">184</span><br></pre></td><td class="code"><pre><code class="hljs python"><span class="hljs-keyword">import</span> socket<br><span class="hljs-keyword">import</span> threading<br><span class="hljs-keyword">import</span> json<br><span class="hljs-keyword">import</span> time<br><span class="hljs-keyword">import</span> queue<br><br><br><span class="hljs-comment"># 客户端配置常量</span><br>HEARTBEAT_INTERVAL = <span class="hljs-number">30</span>    <span class="hljs-comment"># Tracker心跳间隔（秒）</span><br>NAT_KEEPALIVE_INTERVAL = <span class="hljs-number">10</span>  <span class="hljs-comment"># NAT维持间隔（秒）</span><br>RETRY_DELAY = <span class="hljs-number">5</span>            <span class="hljs-comment"># 重试等待时间（秒）</span><br>MAX_RETRIES = <span class="hljs-number">10</span>           <span class="hljs-comment"># 最大重试次数</span><br><br><span class="hljs-keyword">class</span> <span class="hljs-title class_">P2PClient</span>:<br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">__init__</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-comment"># 创建UDP socket并绑定本地端口（0为自动分配）</span><br>        <span class="hljs-variable language_">self</span>.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)<br>        <span class="hljs-variable language_">self</span>.sock.bind((<span class="hljs-string">&#x27;0.0.0.0&#x27;</span>, <span class="hljs-number">0</span>))<br>        <span class="hljs-variable language_">self</span>.local_addr = <span class="hljs-variable language_">self</span>.sock.getsockname()<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;本地UDP绑定: <span class="hljs-subst">&#123;self.local_addr&#125;</span>&quot;</span>)<br><br>        <span class="hljs-comment"># 用户ID、目标ID、目标地址</span><br>        <span class="hljs-variable language_">self</span>.user_id = <span class="hljs-literal">None</span><br>        <span class="hljs-variable language_">self</span>.target_id = <span class="hljs-literal">None</span><br>        <span class="hljs-variable language_">self</span>.target_addr = <span class="hljs-literal">None</span><br><br>        <span class="hljs-comment"># Tracker地址（用户输入）</span><br>        <span class="hljs-variable language_">self</span>.tracker_host = <span class="hljs-literal">None</span><br>        <span class="hljs-variable language_">self</span>.tracker_port = <span class="hljs-number">8000</span>  <span class="hljs-comment"># 默认端口，与服务器匹配</span><br><br>        <span class="hljs-comment"># 线程锁和连接标志</span><br>        <span class="hljs-variable language_">self</span>.lock = threading.Lock()<br>        <span class="hljs-variable language_">self</span>.connected = <span class="hljs-literal">False</span><br><br>        <span class="hljs-comment"># 队列：用于分发Tracker响应</span><br>        <span class="hljs-variable language_">self</span>.tracker_queue = queue.Queue()<br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">register_to_tracker</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;发送心跳注册到Tracker（无响应）&quot;&quot;&quot;</span><br>        <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.user_id:<br>            <span class="hljs-keyword">return</span><br>        msg = <span class="hljs-string">f&quot;reg_heart,<span class="hljs-subst">&#123;self.user_id&#125;</span>&quot;</span>.encode(<span class="hljs-string">&#x27;utf-8&#x27;</span>)<br>        <span class="hljs-variable language_">self</span>.sock.sendto(msg, (<span class="hljs-variable language_">self</span>.tracker_host, <span class="hljs-variable language_">self</span>.tracker_port))<br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">get_target_addr_from_tracker</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;从Tracker获取目标地址：发送后从队列等待响应&quot;&quot;&quot;</span><br>        <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.target_id:<br>            <span class="hljs-keyword">return</span> <span class="hljs-literal">None</span><br>        msg = <span class="hljs-string">f&quot;get_user,<span class="hljs-subst">&#123;self.user_id&#125;</span>,<span class="hljs-subst">&#123;self.target_id&#125;</span>&quot;</span>.encode(<span class="hljs-string">&#x27;utf-8&#x27;</span>)<br>        <span class="hljs-variable language_">self</span>.sock.sendto(msg, (<span class="hljs-variable language_">self</span>.tracker_host, <span class="hljs-variable language_">self</span>.tracker_port))<br><br>        <span class="hljs-keyword">try</span>:<br>            response = <span class="hljs-variable language_">self</span>.tracker_queue.get(timeout=<span class="hljs-number">5</span>)<br>            target_addr = <span class="hljs-built_in">tuple</span>(json.loads(response))<br>            <span class="hljs-keyword">return</span> target_addr<br>        <span class="hljs-keyword">except</span> queue.Empty:<br>            <span class="hljs-keyword">return</span> <span class="hljs-literal">None</span><br>        <span class="hljs-keyword">except</span> json.JSONDecodeError:<br>            <span class="hljs-keyword">return</span> <span class="hljs-literal">None</span><br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">send_punch_hole</span>(<span class="hljs-params">self, addr</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;发送打洞消息，留下NAT痕迹&quot;&quot;&quot;</span><br>        punch_msg = <span class="hljs-string">f&quot;punch,<span class="hljs-subst">&#123;self.user_id&#125;</span>&quot;</span>.encode(<span class="hljs-string">&#x27;utf-8&#x27;</span>)<br>        <span class="hljs-variable language_">self</span>.sock.sendto(punch_msg, addr)<br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">send_chat_message</span>(<span class="hljs-params">self, message</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;发送聊天消息&quot;&quot;&quot;</span><br>        <span class="hljs-keyword">with</span> <span class="hljs-variable language_">self</span>.lock:<br>            <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.target_addr <span class="hljs-keyword">or</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.connected:<br>                <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;未连接，无法发送&quot;</span>)<br>                <span class="hljs-keyword">return</span><br>            chat_msg = <span class="hljs-string">f&quot;chat,<span class="hljs-subst">&#123;self.user_id&#125;</span>,<span class="hljs-subst">&#123;message&#125;</span>&quot;</span>.encode(<span class="hljs-string">&#x27;utf-8&#x27;</span>)<br>            <span class="hljs-variable language_">self</span>.sock.sendto(chat_msg, <span class="hljs-variable language_">self</span>.target_addr)<br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">send_keepalive</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;发送NAT维持消息&quot;&quot;&quot;</span><br>        <span class="hljs-keyword">with</span> <span class="hljs-variable language_">self</span>.lock:<br>            <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.target_addr <span class="hljs-keyword">or</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.connected:<br>                <span class="hljs-keyword">return</span><br>            keep_msg = <span class="hljs-string">f&quot;keepalive,<span class="hljs-subst">&#123;self.user_id&#125;</span>&quot;</span>.encode(<span class="hljs-string">&#x27;utf-8&#x27;</span>)<br>            <span class="hljs-variable language_">self</span>.sock.sendto(keep_msg, <span class="hljs-variable language_">self</span>.target_addr)<br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">receive_messages</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;接收线程：统一recv所有UDP包，分发处理&quot;&quot;&quot;</span><br>        <span class="hljs-keyword">while</span> <span class="hljs-literal">True</span>:<br>            <span class="hljs-keyword">try</span>:<br>                data, addr = <span class="hljs-variable language_">self</span>.sock.recvfrom(<span class="hljs-number">1024</span>)<br>                msg = data.decode(<span class="hljs-string">&#x27;utf-8&#x27;</span>).strip() <br><br>                <span class="hljs-comment"># 尝试解析为Tracker响应</span><br>                <span class="hljs-keyword">try</span>:<br>                    parsed = json.loads(msg) <span class="hljs-comment">#这个isinstance是检查变量是不是某个类</span><br>                    <span class="hljs-keyword">if</span> <span class="hljs-built_in">isinstance</span>(parsed, <span class="hljs-built_in">list</span>) <span class="hljs-keyword">and</span> <span class="hljs-built_in">len</span>(parsed) == <span class="hljs-number">2</span> <span class="hljs-keyword">and</span> <span class="hljs-built_in">isinstance</span>(parsed[<span class="hljs-number">0</span>], <span class="hljs-built_in">str</span>) <span class="hljs-keyword">and</span> <span class="hljs-built_in">isinstance</span>(parsed[<span class="hljs-number">1</span>], (<span class="hljs-built_in">int</span>, <span class="hljs-built_in">float</span>)):<br>                        <span class="hljs-variable language_">self</span>.tracker_queue.put(msg)<br>                        <span class="hljs-keyword">continue</span><br>                <span class="hljs-keyword">except</span> json.JSONDecodeError:<br>                    <span class="hljs-keyword">pass</span><br><br>                <span class="hljs-comment"># 处理P2P消息</span><br>                parts = msg.split(<span class="hljs-string">&#x27;,&#x27;</span>, <span class="hljs-number">2</span>)<br>                <span class="hljs-keyword">if</span> <span class="hljs-built_in">len</span>(parts) &lt; <span class="hljs-number">2</span>:<br>                    <span class="hljs-keyword">continue</span><br><br>                msg_type, sender_id = parts[<span class="hljs-number">0</span>], parts[<span class="hljs-number">1</span>]<br><br>                <span class="hljs-keyword">if</span> msg_type == <span class="hljs-string">&#x27;punch&#x27;</span> <span class="hljs-keyword">and</span> sender_id == <span class="hljs-variable language_">self</span>.target_id:<br>                    <span class="hljs-keyword">with</span> <span class="hljs-variable language_">self</span>.lock:<br>                        <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.connected:<br>                            <span class="hljs-variable language_">self</span>.connected = <span class="hljs-literal">True</span><br>                            <span class="hljs-variable language_">self</span>.target_addr = addr<br>                            <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;连接成功: <span class="hljs-subst">&#123;addr&#125;</span>&quot;</span>)<br><br>                <span class="hljs-keyword">elif</span> msg_type == <span class="hljs-string">&#x27;chat&#x27;</span> <span class="hljs-keyword">and</span> <span class="hljs-built_in">len</span>(parts) == <span class="hljs-number">3</span> <span class="hljs-keyword">and</span> sender_id == <span class="hljs-variable language_">self</span>.target_id:<br>                    <span class="hljs-built_in">print</span>(<span class="hljs-string">f&quot;[<span class="hljs-subst">&#123;sender_id&#125;</span>]: <span class="hljs-subst">&#123;parts[<span class="hljs-number">2</span>]&#125;</span>&quot;</span>)<br><br>                <span class="hljs-keyword">elif</span> msg_type == <span class="hljs-string">&#x27;keepalive&#x27;</span> <span class="hljs-keyword">and</span> sender_id == <span class="hljs-variable language_">self</span>.target_id:<br>                    <span class="hljs-keyword">pass</span>  <span class="hljs-comment"># 忽略，保持安静</span><br><br>            <span class="hljs-keyword">except</span> Exception <span class="hljs-keyword">as</span> e:<br>                <span class="hljs-keyword">pass</span><br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">heartbeat_thread</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;心跳线程：定期注册&quot;&quot;&quot;</span><br>        <span class="hljs-keyword">while</span> <span class="hljs-literal">True</span>:<br>            <span class="hljs-variable language_">self</span>.register_to_tracker()<br>            time.sleep(HEARTBEAT_INTERVAL)<br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">keepalive_thread</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;NAT维持线程：连接后定期发送&quot;&quot;&quot;</span><br>        <span class="hljs-keyword">while</span> <span class="hljs-literal">True</span>:<br>            <span class="hljs-variable language_">self</span>.send_keepalive()<br>            time.sleep(NAT_KEEPALIVE_INTERVAL)<br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">connect_to_target</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;连接逻辑：尝试获取地址并打洞&quot;&quot;&quot;</span><br>        retries = <span class="hljs-number">0</span><br>        <span class="hljs-keyword">while</span> retries &lt; MAX_RETRIES <span class="hljs-keyword">and</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.connected:<br>            <span class="hljs-variable language_">self</span>.register_to_tracker()<br>            addr = <span class="hljs-variable language_">self</span>.get_target_addr_from_tracker()<br>            <span class="hljs-keyword">if</span> addr:<br>                <span class="hljs-keyword">with</span> <span class="hljs-variable language_">self</span>.lock:<br>                    <span class="hljs-variable language_">self</span>.target_addr = addr<br>                <span class="hljs-comment"># 发送多次打洞消息，提高成功率</span><br>                <span class="hljs-keyword">for</span> _ <span class="hljs-keyword">in</span> <span class="hljs-built_in">range</span>(<span class="hljs-number">3</span>):<br>                    <span class="hljs-variable language_">self</span>.send_punch_hole(addr)<br>                    time.sleep(<span class="hljs-number">0.5</span>)<br>            time.sleep(<span class="hljs-number">5</span>)  <span class="hljs-comment"># 等待响应</span><br>            retries += <span class="hljs-number">1</span><br><br>    <span class="hljs-keyword">def</span> <span class="hljs-title function_">run</span>(<span class="hljs-params">self</span>):<br>        <span class="hljs-string">&quot;&quot;&quot;主逻辑&quot;&quot;&quot;</span><br>        <span class="hljs-comment"># 输入Tracker地址</span><br>        <span class="hljs-variable language_">self</span>.tracker_host = <span class="hljs-built_in">input</span>(<span class="hljs-string">&quot;请输入Tracker IP地址: &quot;</span>).strip()<br>        <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.tracker_host:<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;地址不能为空&quot;</span>)<br>            <span class="hljs-keyword">return</span><br>        <span class="hljs-variable language_">self</span>.user_id = <span class="hljs-built_in">input</span>(<span class="hljs-string">&quot;请输入用户名: &quot;</span>).strip()<br>        <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.user_id:<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;用户名不能为空&quot;</span>)<br>            <span class="hljs-keyword">return</span><br>        <span class="hljs-comment"># 启动接收和心跳线程</span><br>        threading.Thread(target=<span class="hljs-variable language_">self</span>.receive_messages, daemon=<span class="hljs-literal">True</span>).start()<br>        threading.Thread(target=<span class="hljs-variable language_">self</span>.heartbeat_thread, daemon=<span class="hljs-literal">True</span>).start()<br>        <span class="hljs-variable language_">self</span>.register_to_tracker()<br>        <span class="hljs-variable language_">self</span>.target_id = <span class="hljs-built_in">input</span>(<span class="hljs-string">&quot;请输入目标用户名: &quot;</span>).strip()<br>        <span class="hljs-keyword">if</span> <span class="hljs-keyword">not</span> <span class="hljs-variable language_">self</span>.target_id:<br>            <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;目标不能为空&quot;</span>)<br>            <span class="hljs-keyword">return</span><br>        <span class="hljs-comment"># 尝试连接，但无论成功与否都进入聊天</span><br>        <span class="hljs-variable language_">self</span>.connect_to_target()<br>        threading.Thread(target=<span class="hljs-variable language_">self</span>.keepalive_thread, daemon=<span class="hljs-literal">True</span>).start()<br>        <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;聊天开始&quot;</span>)<br>        <span class="hljs-keyword">while</span> <span class="hljs-literal">True</span>:<br>            <span class="hljs-keyword">try</span>:<br>                message = <span class="hljs-built_in">input</span>(<span class="hljs-string">&quot;&quot;</span>)<br>                <span class="hljs-keyword">if</span> message.strip():<br>                    <span class="hljs-variable language_">self</span>.send_chat_message(message)<br>            <span class="hljs-keyword">except</span> KeyboardInterrupt:<br>                <span class="hljs-built_in">print</span>(<span class="hljs-string">&quot;退出&quot;</span>)<br>                <span class="hljs-keyword">break</span><br><br><span class="hljs-keyword">if</span> __name__ == <span class="hljs-string">&quot;__main__&quot;</span>:<br>    client = P2PClient()<br>    client.run()<br></code></pre></td></tr></table></figure><p>蛋疼写的聊天室 后来就想这个挺有意思的<br>服务端是自己写的 但是客户端是自己写的框架，ai填的 之后会自己重写一遍 </p>]]></content>
    
    
    
